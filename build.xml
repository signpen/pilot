<?xml version="1.0" encoding="UTF-8"?>
<project name="pilot-web" default="help" basedir=".">
    <description>
        Compile once, then package per-server WAR files with env/server-specific config.properties.
    </description>

    <property name="app.name" value="pilot"/>
    <property name="src.dir" value="src/main/java"/>
    <property name="resources.dir" value="src/main/resources"/>
    <property name="web.dir" value="src/main/webapp"/>
    <property name="lib.dir" value="${web.dir}/WEB-INF/lib"/>
    <property name="legacy.lib.dir" value="lib"/>

    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="stage.common.dir" value="${build.dir}/stage-common"/>
    <property name="package.dir" value="${build.dir}/package"/>
    <property name="dist.dir" value="dist"/>

    <property name="java.source" value="1.8"/>
    <property name="java.target" value="1.8"/>

    <!-- runtime input examples:
         ./ant.sh dist-all -Ddeploy.env=staging
         ./ant.sh war -Ddeploy.env=product -Ddeploy.server=web1
    -->
    <property name="deploy.env" value=""/>
    <property name="deploy.server" value=""/>

    <path id="compile.classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar" erroronmissingdir="false"/>
        <fileset dir="${legacy.lib.dir}" includes="**/*.jar" erroronmissingdir="false"/>
    </path>

    <target name="help">
        <echo><![CDATA[
Usage:
  ./ant.sh clean
  ./ant.sh dist-all -Ddeploy.env=staging
  ./ant.sh war -Ddeploy.env=product -Ddeploy.server=web1

Expected config layout:
  src/main/resources/servers/<env>/config-web1.properties
  src/main/resources/servers/<env>/config-web2.properties
  src/main/resources/servers/<env>/config-batch.properties

Output examples:
  dist/pilot-staging-web1.war
  dist/pilot-staging-web2.war
  dist/pilot-staging-batch.war
        ]]></echo>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${stage.common.dir}"/>
        <mkdir dir="${package.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="validate-env">
        <condition property="deploy.env.present">
            <length string="${deploy.env}" when="greater" length="0"/>
        </condition>
        <fail unless="deploy.env.present" message="deploy.env is required. Example: -Ddeploy.env=staging"/>
    </target>

    <target name="validate-server">
        <condition property="deploy.server.present">
            <length string="${deploy.server}" when="greater" length="0"/>
        </condition>
        <fail unless="deploy.server.present" message="deploy.server is required. Use one of: web1, web2, batch"/>
        <condition property="valid.server">
            <or>
                <equals arg1="${deploy.server}" arg2="web1"/>
                <equals arg1="${deploy.server}" arg2="web2"/>
                <equals arg1="${deploy.server}" arg2="batch"/>
            </or>
        </condition>
        <fail unless="valid.server" message="Invalid deploy.server='${deploy.server}'. Use web1, web2, or batch."/>
    </target>

    <target name="compile" depends="init" description="Compile Java sources once">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="${java.source}"
               target="${java.target}"
               includeantruntime="false"
               debug="true"
               encoding="UTF-8"
               classpathref="compile.classpath"/>
    </target>

    <target name="stage-common" depends="compile" description="Stage webapp and common resources once">
        <copy todir="${stage.common.dir}">
            <fileset dir="${web.dir}"/>
        </copy>

        <mkdir dir="${stage.common.dir}/WEB-INF/classes"/>
        <mkdir dir="${stage.common.dir}/WEB-INF/lib"/>

        <copy todir="${stage.common.dir}/WEB-INF/classes">
            <fileset dir="${classes.dir}"/>
        </copy>

        <copy todir="${stage.common.dir}/WEB-INF/classes">
            <fileset dir="${resources.dir}" erroronmissingdir="false">
                <exclude name="servers/**"/>
            </fileset>
        </copy>

        <copy todir="${stage.common.dir}/WEB-INF/lib" overwrite="false">
            <fileset dir="${legacy.lib.dir}" includes="**/*.jar" erroronmissingdir="false"/>
        </copy>
    </target>

    <macrodef name="package-server-war">
        <attribute name="server"/>
        <sequential>
            <available file="${resources.dir}/servers/${deploy.env}/config-@{server}.properties"
                       property="config.exists.@{server}"/>
            <fail unless="config.exists.@{server}"
                  message="Missing config file: ${resources.dir}/servers/${deploy.env}/config-@{server}.properties"/>

            <delete dir="${package.dir}/@{server}"/>
            <mkdir dir="${package.dir}/@{server}"/>

            <copy todir="${package.dir}/@{server}">
                <fileset dir="${stage.common.dir}"/>
            </copy>

            <copy file="${resources.dir}/servers/${deploy.env}/config-@{server}.properties"
                  tofile="${package.dir}/@{server}/WEB-INF/classes/config.properties"
                  overwrite="true"/>

            <war destfile="${dist.dir}/${app.name}-${deploy.env}-@{server}.war"
                 webxml="${package.dir}/@{server}/WEB-INF/web.xml">
                <fileset dir="${package.dir}/@{server}" excludes="WEB-INF/web.xml"/>
            </war>
        </sequential>
    </macrodef>

    <target name="war-web1" depends="validate-env,stage-common" description="Build WAR for web1">
        <package-server-war server="web1"/>
    </target>

    <target name="war-web2" depends="validate-env,stage-common" description="Build WAR for web2">
        <package-server-war server="web2"/>
    </target>

    <target name="war-batch" depends="validate-env,stage-common" description="Build WAR for batch">
        <package-server-war server="batch"/>
    </target>

    <target name="war" depends="validate-env,validate-server" description="Build one server-specific WAR">
        <antcall target="war-${deploy.server}"/>
    </target>

    <target name="dist-all" depends="clean,validate-env,war-web1,war-web2,war-batch"
            description="Build all server WAR files for one environment"/>

    <target name="package" depends="dist-all"/>
</project>
