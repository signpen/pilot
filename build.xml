<?xml version="1.0" encoding="UTF-8"?>
<project name="pilot-web" default="war" basedir=".">
    <description>Simple Ant-based Spring MVC sample for the pilot repository</description>

    <property name="app.name" value="pilot"/>
    <property name="src.dir" value="src/main/java"/>
    <property name="web.dir" value="src/main/webapp"/>
    <property name="lib.dir" value="lib"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="web.build.dir" value="${build.dir}/webapp"/>
    <property name="dist.dir" value="dist"/>
    <property name="java.source" value="1.8"/>
    <property name="java.target" value="1.8"/>
    <property name="spring.version" value="4.3.30.RELEASE"/>
    <property name="servlet.api.version" value="3.1.0"/>
    <property name="commons.logging.version" value="1.2"/>
    <property name="maven.repo" value="https://repo.maven.apache.org/maven2"/>

    <path id="compile.classpath">
        <fileset dir="${lib.dir}" includes="*.jar"/>
    </path>

    <target name="init">
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${web.build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="bootstrap" depends="init" description="Download project dependencies from Maven Central">
        <get src="${maven.repo}/org/springframework/spring-webmvc/${spring.version}/spring-webmvc-${spring.version}.jar" dest="${lib.dir}/spring-webmvc-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-web/${spring.version}/spring-web-${spring.version}.jar" dest="${lib.dir}/spring-web-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-context/${spring.version}/spring-context-${spring.version}.jar" dest="${lib.dir}/spring-context-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-beans/${spring.version}/spring-beans-${spring.version}.jar" dest="${lib.dir}/spring-beans-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-core/${spring.version}/spring-core-${spring.version}.jar" dest="${lib.dir}/spring-core-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-expression/${spring.version}/spring-expression-${spring.version}.jar" dest="${lib.dir}/spring-expression-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/springframework/spring-aop/${spring.version}/spring-aop-${spring.version}.jar" dest="${lib.dir}/spring-aop-${spring.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/commons-logging/commons-logging/${commons.logging.version}/commons-logging-${commons.logging.version}.jar" dest="${lib.dir}/commons-logging-${commons.logging.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/javax/servlet/javax.servlet-api/${servlet.api.version}/javax.servlet-api-${servlet.api.version}.jar" dest="${lib.dir}/javax.servlet-api-${servlet.api.version}.jar" skipexisting="true"/>
    </target>

    <target name="compile" depends="bootstrap" description="Compile Java source">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="${java.source}"
               target="${java.target}"
               includeantruntime="false"
               debug="true"
               encoding="UTF-8"
               classpathref="compile.classpath"/>
    </target>

    <target name="prepare-webapp" depends="compile" description="Prepare web resources">
        <copy todir="${web.build.dir}">
            <fileset dir="${web.dir}"/>
        </copy>
        <mkdir dir="${web.build.dir}/WEB-INF/classes"/>
        <copy todir="${web.build.dir}/WEB-INF/classes">
            <fileset dir="${classes.dir}"/>
        </copy>
        <mkdir dir="${web.build.dir}/WEB-INF/lib"/>
        <copy todir="${web.build.dir}/WEB-INF/lib">
            <fileset dir="${lib.dir}" includes="*.jar" excludes="javax.servlet-api-*.jar"/>
        </copy>
    </target>

    <target name="war" depends="clean,prepare-webapp" description="Build WAR artifact">
        <war destfile="${dist.dir}/${app.name}.war" webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${web.build.dir}" excludes="WEB-INF/web.xml"/>
        </war>
    </target>

    <target name="package" depends="war"/>
</project>
